# PropChain Environment Configuration Template
APP_NAME=PropChain API
APP_ENV=development
DEBUG=true

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database Configuration (Persistent data stored in MongoDB Atlas)
DATABASE_URL=sqlite:///:memory:
MONGODB_URI=
MONGODB_DB_NAME=propchain

# Security & JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=propchain
JWT_AUDIENCE=propchain-api
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

LOG_LEVEL=INFO
LOG_DIR=logs

# Blockchain Configuration
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_NETWORK_NAME=Hardhat EVM Localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_DEPLOYER_PRIVATE_KEY=
BLOCKCHAIN_DEPLOYER_ADDRESS=
PROPERTY_REGISTRY_ADDRESS=
OWNERSHIP_REGISTRY_ADDRESS=
TRANSACTION_MANAGER_ADDRESS=

# Fallback Development Accounts
DEFAULT_SELLER_WALLET=
DEFAULT_BUYER_WALLET=
DEFAULT_DOCUMENT_HASH=
DEMO_USER_PASSWORD=
