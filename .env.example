# ==============================================================================
# PropChain Environment Configuration Template
# Ownership:
# - APP_*, FRONTEND_*, BACKEND_*, DATABASE_*, JWT_*, DOCUMENT_*: Backend / Core
# - BLOCKCHAIN_*: Backend / Blockchain integration
# - Frontend-consumed variables must be prefixed with VITE_ and reside in frontend/.env
# ==============================================================================

# Core Application Settings
APP_NAME=PropChain
APP_ENV=development

# Service URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database Configuration (PostgreSQL with psycopg driver)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/propchain

# Security & Authentication Secrets (Replace in local .env with 64+ char random hex string)
JWT_SECRET_KEY=REPLACE_WITH_SECURE_SECRET

# Blockchain Node / RPC Settings
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337

# Smart Contract Addresses (Populated after local/testnet deployment in Phase 7+)
PROPERTY_REGISTRY_ADDRESS=
OWNERSHIP_REGISTRY_ADDRESS=
TRANSACTION_MANAGER_ADDRESS=

# Document Storage Settings
DOCUMENT_STORAGE_PATH=storage/uploads

