# ==============================================================================
# PropChain Backend Environment Configuration Template
# Phase 4: Authentication & Authorization
# NEVER commit production credentials or secrets to version control.
# ==============================================================================

# Application Configuration
APP_NAME=PropChain API
APP_ENV=development
DEBUG=true

# Server Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Integration
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/propchain
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Security & JWT Authentication
JWT_SECRET_KEY=REPLACE_WITH_SECURE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=propchain
JWT_AUDIENCE=propchain-api

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Centralized Logging
LOG_LEVEL=INFO
LOG_DIR=logs
